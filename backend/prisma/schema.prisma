generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DataSource {
  id                   String                @id @default(uuid())
  /// *
  /// * Stable code identifier used by the backend registry.
  /// * Examples: youtube, github, dev-to, google-play.
  key                  String                @unique
  displayName          String                @map("display_name")
  description          String?
  isActive             Boolean               @default(true) @map("is_active")
  /// *
  /// * Indicates whether the collector implementation is currently
  /// * available in the deployed backend.
  isImplemented        Boolean               @default(false) @map("is_implemented")
  supportsPosts        Boolean               @default(true) @map("supports_posts")
  supportsComments     Boolean               @default(false) @map("supports_comments")
  supportsRegion       Boolean               @default(false) @map("supports_region")
  supportsLanguage     Boolean               @default(false) @map("supports_language")
  configuration        Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  collectionJobSources CollectionJobSource[]
  socialPosts          SocialPost[]

  @@index([isActive])
  @@index([isImplemented])
  @@map("data_sources")
}

model CollectionJobSource {
  id              String              @id @default(uuid())
  collectionJobId String              @map("collection_job_id")
  dataSourceId    String              @map("data_source_id")
  status          CollectionJobStatus @default(PENDING)
  totalPosts      Int                 @default(0) @map("total_posts")
  totalComments   Int                 @default(0) @map("total_comments")
  startedAt       DateTime?           @map("started_at")
  completedAt     DateTime?           @map("completed_at")
  failureReason   String?             @map("failure_reason")
  collectionJob   CollectionJob       @relation(fields: [collectionJobId], references: [id], onDelete: Cascade)
  dataSource      DataSource          @relation(fields: [dataSourceId], references: [id])

  @@unique([collectionJobId, dataSourceId])
  @@index([collectionJobId])
  @@index([dataSourceId])
  @@index([status])
  @@map("collection_job_sources")
}

model User {
  id                          String                      @id @default(uuid())
  fullName                    String                      @map("full_name")
  email                       String                      @unique
  passwordHash                String                      @map("password_hash")
  role                        UserRole                    @default(USER)
  accountStatus               AccountStatus               @default(NORMAL) @map("account_status")
  freeGenerationLimit         Int                         @default(3) @map("free_generation_limit")
  freeGenerationsUsed         Int                         @default(0) @map("free_generations_used")
  creditBalance               Int                         @default(0) @map("credit_balance")
  isActive                    Boolean                     @default(true) @map("is_active")
  isVerified                  Boolean                     @default(false) @map("is_verified")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")
  failedLoginAttempts         Int                         @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime?                   @map("locked_until")
  emailVerifiedAt             DateTime?                   @map("email_verified_at")
  lastLoginAt                 DateTime?                   @map("last_login_at")
  passwordChangedAt           DateTime?                   @map("password_changed_at")
  userType                    UserType
  failedLoginWindowStartedAt  DateTime?                   @map("failed_login_window_started_at")
  loginLockLevel              Int                         @default(0) @map("login_lock_level")
  deletedAt                   DateTime?                   @map("deleted_at")
  verificationEmailSentAt     DateTime?                   @map("verification_email_sent_at")
  premiumActivatedAt          DateTime?                   @map("premium_activated_at")
  alerts                      Alert[]
  avatarUrl                   String?                     @map("avatar_url")
  auditLogs                   AuditLog[]                  @relation("AuditLogs")
  authenticationLogs          AuthenticationLog[]
  chatSessions                ChatSession[]
  emailChangeRequests         EmailChangeRequest[]
  collectionJobs              CollectionJob[]             @relation("CollectionJobsCreatedBy")
  complaints                  Complaint[]
  contactMessages             ContactMessage[]
  creditTransactions          CreditTransaction[]
  emailVerificationTokens     EmailVerificationToken[]
  externalApiLogs             ExternalApiLog[]
  favoriteIdeas               FavoriteIdea[]
  generationRuns              IdeaGenerationRun[]
  publicationAcceptances      IdeaPublicationAcceptance[]
  publicationFeedback         IdeaPublicationFeedback[]
  publicationRatings          IdeaPublicationRating[]
  publicationReportsSubmitted IdeaPublicationReport[]     @relation("PublicationReportsSubmitted")
  publicationReportsReviewed  IdeaPublicationReport[]     @relation("PublicationReportsReviewed")
  publicationVotes            IdeaPublicationVote[]
  publishedIdeas              IdeaPublication[]           @relation("PublishedIdeas")
  ideas                       Idea[]
  passwordResetTokens         PasswordResetToken[]
  payments                    Payment[]
  promptHistories             PromptHistory[]
  refreshTokens               RefreshToken[]
  savedGenerationSearches     SavedGenerationSearch[]
  updatedSettings             SystemSetting[]             @relation("SettingsUpdatedBy")
  devices                     UserDevice[]
  preferenceSelections        UserPreferenceSelection[]
  preference                  UserPreference?

  @@index([lockedUntil])
  @@index([loginLockLevel])
  @@map("users")
}

model UserDevice {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  fcmToken   String         @unique @map("fcm_token")
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  lastUsedAt DateTime?      @map("last_used_at")
  revokedAt  DateTime?      @map("revoked_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([userId, revokedAt])
  @@map("user_devices")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ipAddress  String?   @map("ip_address")
  lastUsedAt DateTime? @map("last_used_at")
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

/// *
/// * Password Reset Token
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model SystemSetting {
  id                            String   @id @default(uuid())
  /// *
  /// * Price of one credit.
  /// * One credit allows one premium idea generation.
  creditPrice                   Decimal  @map("credit_price") @db.Decimal(10, 2)
  /// *
  /// * Minimum number of purchased credits required
  /// * to receive bonus credits.
  bonusThreshold                Int      @default(0) @map("bonus_threshold")
  /// *
  /// * Number of bonus credits granted when the
  /// * configured threshold is reached.
  bonusCredits                  Int      @default(0) @map("bonus_credits")
  updatedById                   String?  @map("updated_by")
  updatedAt                     DateTime @updatedAt @map("updated_at")
  ideaPromptTemplate            String?  @map("idea_prompt_template")
  /// *
  /// * Guarantees that only one global system-settings row exists.
  key                           String   @unique @default("GLOBAL")
  /// *
  /// * Price paid directly to unlock advanced features
  /// * for one previously generated free idea.
  /// * This payment does not purchase or consume credits.
  directUnlockPrice             Decimal  @default(10) @map("direct_unlock_price") @db.Decimal(10, 2)
  /// *
  /// * Activation fee charged when a NORMAL account transitions to Premium.
  premiumActivationFee          Decimal  @default(5) @map("premium_activation_fee") @db.Decimal(10, 2)
  /// *
  /// * Credits consumed when a Premium user unlocks advanced outputs for an accepted publication.
  publicationAdvancedCreditCost Int      @default(1) @map("publication_advanced_credit_cost")
  /// *
  /// * Fixed price paid by a normal registered user to accept a published idea and unlock all details.
  publishedIdeaPrice            Decimal  @default(15) @map("published_idea_price") @db.Decimal(10, 2)
  updatedBy                     User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("system_settings")
}

model BusinessModelTemplate {
  id                 String              @id @default(uuid())
  /// *
  /// * Stable backend key used by prompts and frontend selection.
  key                String              @unique
  name               String
  description        String?
  /// *
  /// * Ordered canvas sections rendered by the generated business-model output.
  sections           Json
  /// *
  /// * Optional template-specific prompt guidance and validation rules.
  promptGuidance     Json?               @map("prompt_guidance")
  /// *
  /// * Optional UserType names for automatic recommendation.
  supportedUserTypes Json?               @map("supported_user_types")
  /// *
  /// * Optional domain names for automatic recommendation.
  supportedDomains   Json?               @map("supported_domains")
  isActive           Boolean             @default(true) @map("is_active")
  isDefault          Boolean             @default(false) @map("is_default")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  businessModels     IdeaBusinessModel[]

  @@index([isActive, isDefault])
  @@map("business_model_templates")
}

model AuditLog {
  id         String          @id @default(uuid())
  actorId    String?         @map("actor_id")
  action     AuditAction
  targetType AuditTargetType @map("target_type")
  targetId   String?         @map("target_id")
  oldValue   Json?           @map("old_value")
  newValue   Json?           @map("new_value")
  createdAt  DateTime        @default(now()) @map("created_at")
  actor      User?           @relation("AuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model GuestSession {
  id              String              @id @default(uuid())
  /// *
  /// * Public random identifier stored in a secure HTTP-only cookie.
  sessionToken    String              @unique @map("session_token")
  hasGenerated    Boolean             @default(false) @map("has_generated")
  createdAt       DateTime            @default(now()) @map("created_at")
  expiresAt       DateTime?           @map("expires_at")
  /// *
  /// * One-way hash derived from request information.
  /// * Prevents the same guest client from repeatedly creating
  /// * new sessions after consuming the free guest generation.
  fingerprintHash String              @unique @map("fingerprint_hash")
  generationRuns  IdeaGenerationRun[]
  ideas           Idea[]
  promptHistories PromptHistory[]

  publicationVotes    IdeaPublicationVote[]
  publicationRatings  IdeaPublicationRating[]
  publicationFeedback IdeaPublicationFeedback[]

  @@index([expiresAt])
  @@map("guest_sessions")
}

model Idea {
  id                 String              @id @default(uuid())
  userId             String?             @map("user_id")
  guestSessionId     String?             @map("guest_session_id")
  title              String
  limitedAbstract    String?             @map("limited_abstract")
  partialAbstract    String?             @map("partial_abstract")
  fullAbstract       String?             @map("full_abstract")
  problemStatement   String?             @map("problem_statement")
  generationType     IdeaGenerationType  @map("generation_type")
  isUnlocked         Boolean             @default(false) @map("is_unlocked")
  unlockMethod       UnlockMethod        @default(NONE) @map("unlock_method")
  unlockedAt         DateTime?           @map("unlocked_at")
  commentsCount      Int                 @default(0) @map("comments_count")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  selectedRegion     String?             @map("selected_region")
  domainId           String              @map("domain_id")
  collectionJobId    String?             @map("collection_job_id")
  deletedAt          DateTime?           @map("deleted_at")
  objectives         Json?
  targetUsers        Json?               @map("target_users")
  chatSessions       ChatSession[]
  complaints         Complaint[]
  creditTransactions CreditTransaction[]
  externalApiLogs    ExternalApiLog[]
  favorites          FavoriteIdea[]
  generatedOutputs   GeneratedOutput[]
  businessModels     IdeaBusinessModel[]
  generationRun      IdeaGenerationRun?
  publication        IdeaPublication?
  collectionJob      CollectionJob?      @relation(fields: [collectionJobId], references: [id])
  domain             Domain              @relation(fields: [domainId], references: [id])
  guestSession       GuestSession?       @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  promptHistories    PromptHistory[]

  @@index([userId, createdAt])
  @@index([guestSessionId])
  @@index([generationType])
  @@index([isUnlocked])
  @@index([collectionJobId])
  @@map("ideas")
}

model Payment {
  id                             String                     @id @default(uuid())
  userId                         String                     @map("user_id")
  ideaId                         String?                    @map("idea_id")
  amount                         Decimal                    @db.Decimal(10, 2)
  currency                       String                     @default("USD")
  status                         PaymentStatus              @default(PENDING)
  paymentPurpose                 PaymentPurpose             @map("payment_purpose")
  creditsAmount                  Int                        @default(0) @map("credits_amount")
  creditPriceAtPurchase          Decimal?                   @map("credit_price_at_purchase") @db.Decimal(10, 2)
  transactionReference           String?                    @map("transaction_reference")
  createdAt                      DateTime                   @default(now()) @map("created_at")
  updatedAt                      DateTime                   @updatedAt @map("updated_at")
  bonusCreditsAmount             Int                        @default(0) @map("bonus_credits_amount")
  failedAt                       DateTime?                  @map("failed_at")
  failureReason                  String?                    @map("failure_reason")
  paidAt                         DateTime?                  @map("paid_at")
  providerPaymentId              String?                    @unique @map("provider_payment_id")
  providerSessionId              String?                    @unique @map("provider_session_id")
  refundedAt                     DateTime?                  @map("refunded_at")
  idempotencyKey                 String?                    @unique @map("idempotency_key")
  /// *
  /// * User-facing method.
  /// * Examples: card, paypal.
  paymentMethodKey               String                     @map("payment_method_key")
  /// *
  /// * Backend gateway implementation.
  /// * Examples: stripe, paypal.
  providerKey                    String                     @map("provider_key")
  acceptanceCity                 String?                    @map("acceptance_city")
  /// *
  /// * Location snapshot used only when fulfilling a publication acceptance.
  acceptanceCountry              String?                    @map("acceptance_country")
  acceptanceRegion               String?                    @map("acceptance_region")
  activatesPremium               Boolean                    @default(false) @map("activates_premium")
  premiumActivationFeeAtPurchase Decimal?                   @map("premium_activation_fee_at_purchase") @db.Decimal(10, 2)
  publicationId                  String?                    @map("publication_id")
  creditTransactions             CreditTransaction[]
  publicationAcceptance          IdeaPublicationAcceptance?
  idea                           Idea?                      @relation(fields: [ideaId], references: [id])
  publication                    IdeaPublication?           @relation(fields: [publicationId], references: [id])
  user                           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ideaId])
  @@index([publicationId])
  @@index([status])
  @@index([providerKey])
  @@index([paymentMethodKey])
  @@index([paymentPurpose])
  @@index([createdAt])
  @@map("payments")
}

model CreditTransaction {
  id                      String                     @id @default(uuid())
  userId                  String                     @map("user_id")
  paymentId               String?                    @map("payment_id")
  ideaId                  String?                    @map("idea_id")
  type                    CreditTransactionType
  amount                  Int
  balanceAfter            Int                        @map("balance_after")
  description             String?
  createdAt               DateTime                   @default(now()) @map("created_at")
  publicationAcceptanceId String?                    @map("publication_acceptance_id")
  idea                    Idea?                      @relation(fields: [ideaId], references: [id])
  payment                 Payment?                   @relation(fields: [paymentId], references: [id])
  publicationAcceptance   IdeaPublicationAcceptance? @relation(fields: [publicationAcceptanceId], references: [id])
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paymentId, type])
  @@index([userId])
  @@index([paymentId])
  @@index([ideaId])
  @@index([publicationAcceptanceId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
}

model ChatSession {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  ideaId        String        @map("idea_id")
  title         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  lastMessageAt DateTime      @default(now()) @map("last_message_at")
  messages      ChatMessage[]
  idea          Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, lastMessageAt])
  @@index([ideaId, deletedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String            @id @default(uuid())
  sessionId       String            @map("session_id")
  sender          ChatSender
  message         String
  createdAt       DateTime          @default(now()) @map("created_at")
  completedAt     DateTime?         @map("completed_at")
  deletedAt       DateTime?         @map("deleted_at")
  errorCode       String?           @map("error_code")
  errorMessage    String?           @map("error_message")
  status          ChatMessageStatus @default(COMPLETED)
  updatedAt       DateTime          @updatedAt @map("updated_at")
  /// *
  /// * Identifier generated by the frontend for idempotent user-message
  /// * submission. AI messages do not require this value.
  clientRequestId String?           @map("client_request_id")
  session         ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientRequestId])
  @@index([sessionId, deletedAt, createdAt])
  @@index([sessionId, status])
  @@map("chat_messages")
}

model Alert {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      AlertType @default(SYSTEM)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("alerts")
}

model Complaint {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  ideaId     String?           @map("idea_id")
  subject    String
  message    String
  status     ComplaintStatus   @default(OPEN)
  priority   ComplaintPriority @default(MEDIUM)
  adminReply String?           @map("admin_reply")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  resolvedAt DateTime?         @map("resolved_at")
  deletedAt  DateTime?         @map("deleted_at")
  idea       Idea?             @relation(fields: [ideaId], references: [id])
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt, createdAt])
  @@index([ideaId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("complaints")
}

model ExternalApiLog {
  id              String                  @id @default(uuid())
  userId          String?                 @map("user_id")
  ideaId          String?                 @map("idea_id")
  endpoint        String?
  requestType     ApiRequestType          @map("request_type")
  statusCode      Int?                    @map("status_code")
  isSuccess       Boolean                 @default(false) @map("is_success")
  responseTimeMs  Int?                    @map("response_time_ms")
  errorMessage    String?                 @map("error_message")
  costEstimate    Decimal?                @map("cost_estimate") @db.Decimal(12, 6)
  createdAt       DateTime                @default(now()) @map("created_at")
  requestId       String?                 @map("request_id")
  aiModelId       String?                 @map("ai_model_id")
  apiModelId      String?                 @map("api_model_id")
  inputTokens     Int?                    @map("input_tokens")
  outputTokens    Int?                    @map("output_tokens")
  attemptNumber   Int                     @default(1) @map("attempt_number")
  fallbackUsed    Boolean                 @default(false) @map("fallback_used")
  operationId     String?                 @map("operation_id")
  providerKey     String                  @map("provider_key")
  serviceCategory ExternalServiceCategory @map("service_category")
  errorCode       String?                 @map("error_code")
  isRetryable     Boolean?                @map("is_retryable")
  aiModel         AiModel?                @relation(fields: [aiModelId], references: [id])
  idea            Idea?                   @relation(fields: [ideaId], references: [id])
  user            User?                   @relation(fields: [userId], references: [id])

  @@index([aiModelId, createdAt])
  @@index([operationId])
  @@index([operationId, attemptNumber])
  @@index([providerKey, createdAt])
  @@index([errorCode, createdAt])
  @@index([isRetryable, createdAt])
  @@index([serviceCategory, createdAt])
  @@index([requestType, createdAt])
  @@index([isSuccess, createdAt])
  @@index([userId, createdAt])
  @@index([ideaId, createdAt])
  @@map("external_api_logs")
}

model Domain {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  isActive                Boolean                 @default(true) @map("is_active")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  collectionJobs          CollectionJob[]
  domainKeywords          DomainKeyword[]
  ideas                   Idea[]
  topicRules              NlpTopicRule[]
  savedGenerationSearches SavedGenerationSearch[]

  @@map("domains")
}

model DomainKeyword {
  id        String       @id @default(uuid())
  domainId  String       @map("domain_id")
  keyword   String
  createdAt DateTime     @default(now()) @map("created_at")
  language  LanguageCode @default(ANY)
  domain    Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, keyword, language])
  @@index([domainId])
  @@index([language])
  @@map("domain_keywords")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("email_verification_tokens")
}

model AuthenticationLog {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  action    AuthAction
  email     String?
  isSuccess Boolean    @default(true) @map("is_success")
  message   String?
  createdAt DateTime   @default(now()) @map("created_at")
  ipAddress String?    @map("ip_address")
  userAgent String?    @map("user_agent")
  user      User?      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([email])
  @@index([createdAt])
  @@map("authentication_logs")
}

model CollectionJob {
  id                         String                 @id @default(uuid())
  domainId                   String                 @map("domain_id")
  country                    String?
  city                       String?
  region                     String?
  radiusKm                   Int?                   @map("radius_km")
  keywords                   Json?
  status                     CollectionJobStatus    @default(PENDING)
  totalPosts                 Int                    @default(0) @map("total_posts")
  totalComments              Int                    @default(0) @map("total_comments")
  startedAt                  DateTime?              @map("started_at")
  completedAt                DateTime?              @map("completed_at")
  failedReason               String?                @map("failed_reason")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  language                   LanguageCode
  /// *
  /// * User who started or owns this collection job.
  /// * Nullable to support guest, internal, and legacy jobs.
  createdById                String?                @map("created_by_id")
  domainResolutionConfidence Decimal?               @map("domain_resolution_confidence") @db.Decimal(4, 3)
  domainResolutionSource     DomainResolutionSource @default(USER_SELECTED) @map("domain_resolution_source")
  userDescription            String?                @map("user_description")
  sources                    CollectionJobSource[]
  createdBy                  User?                  @relation("CollectionJobsCreatedBy", fields: [createdById], references: [id])
  domain                     Domain                 @relation(fields: [domainId], references: [id])
  generationRuns             IdeaGenerationRun[]
  ideas                      Idea[]
  nlpAnalysis                NlpAnalysis?
  promptHistories            PromptHistory[]
  posts                      SocialPost[]

  @@index([createdById])
  @@index([domainId])
  @@index([country])
  @@index([status])
  @@index([createdAt])
  @@map("collection_jobs")
}

model SocialPost {
  id              String          @id @default(uuid())
  collectionJobId String          @map("collection_job_id")
