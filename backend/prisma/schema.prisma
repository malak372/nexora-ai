  publication  IdeaPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession GuestSession?   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  @@unique([publicationId, userId])
  @@unique([publicationId, guestSessionId])
  @@index([publicationId, status])
  @@index([userId])
  @@index([guestSessionId])
  @@map("idea_publication_feedback")
}

model IdeaGenerationRun {
  id                  String                    @id @default(uuid())
  userId              String?                   @map("user_id")
  guestSessionId      String?                   @map("guest_session_id")
  lastHeartbeatAt     DateTime?                 @map("last_heartbeat_at")
  cancelRequestedAt   DateTime?                 @map("cancel_requested_at")
  ideaId              String?                   @unique @map("idea_id")
  collectionJobId     String?                   @map("collection_job_id")
  generationType      IdeaGenerationType        @map("generation_type")
  status              IdeaGenerationRunStatus   @default(QUEUED)
  currentStageKey     String?                   @map("current_stage_key")
  progressPercent     Int                       @default(0) @map("progress_percent")
  errorCode           String?                   @map("error_code")
  errorMessage        String?                   @map("error_message")
  startedAt           DateTime?                 @map("started_at")
  completedAt         DateTime?                 @map("completed_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  contextSnapshot     Json?                     @map("context_snapshot")
  nextRetryAt         DateTime?                 @map("next_retry_at")
  pausedAt            DateTime?                 @map("paused_at")
  retryCount          Int                       @default(0) @map("retry_count")
  benchmarkCandidates IdeaGenerationCandidate[]
  collectionJob       CollectionJob?            @relation(fields: [collectionJobId], references: [id])
  guestSession        GuestSession?             @relation(fields: [guestSessionId], references: [id])
  idea                Idea?                     @relation(fields: [ideaId], references: [id])
  user                User?                     @relation(fields: [userId], references: [id])
  stages              IdeaGenerationStage[]
  promptHistories     PromptHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, nextRetryAt])
  @@index([collectionJobId])
  @@map("idea_generation_runs")
}

model IdeaGenerationStage {
  id              String                    @id @default(uuid())
  runId           String                    @map("run_id")
  /// *
  /// * Extensible stage identifier.
  /// * Examples:
  /// * request-validation
  /// * data-source-selection
  /// * data-collection
  /// * nlp-analysis
  /// * idea-generation
  /// * abstract-generation
  /// * business-model
  /// * technology-stack
  /// * feasibility
  stageKey        String                    @map("stage_key")
  displayName     String                    @map("display_name")
  sequence        Int
  status          IdeaGenerationStageStatus @default(PENDING)
  progressPercent Int                       @default(0) @map("progress_percent")
  /// *
  /// * Safe summary displayed to the user.
  resultPreview   Json?                     @map("result_preview")
  errorMessage    String?                   @map("error_message")
  startedAt       DateTime?                 @map("started_at")
  completedAt     DateTime?                 @map("completed_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  attemptCount    Int                       @default(0) @map("attempt_count")
  maxAttempts     Int                       @default(1) @map("max_attempts")
  run             IdeaGenerationRun         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stageKey])
  @@index([runId, sequence])
  @@index([status])
  @@map("idea_generation_stages")
}

model GeneratedOutput {
  id                String                @id @default(uuid())
  ideaId            String                @map("idea_id")
  content           String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  errorMessage      String?               @map("error_message")
  generatedAt       DateTime?             @map("generated_at")
  /// *
  /// * Examples:
  /// * full-abstract
  /// * technology-stack
  /// * system-architecture
  /// * database-design
  /// * business-model
  outputKey         String                @map("output_key")
  sequence          Int                   @default(0)
  status            GeneratedOutputStatus @default(PENDING)
  structuredContent Json?                 @map("structured_content")
  title             String
  idea              Idea                  @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, outputKey])
  @@index([ideaId, sequence])
  @@index([status])
  @@map("generated_outputs")
}

model IdeaPublicationRevision {
  id                String          @id @default(uuid())
  publicationId     String          @map("publication_id")
  version           Int
  publicTitle       String          @map("public_title")
  publicAbstract    String          @map("public_abstract")
  publicProblem     String?         @map("public_problem")
  publicObjectives  String?         @map("public_objectives")
  publicTargetUsers String?         @map("public_target_users")
  createdAt         DateTime        @default(now()) @map("created_at")
  publication       IdeaPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, version])
  @@index([publicationId, createdAt])
  @@map("idea_publication_revisions")
}

/// *
/// * Stores generated business-model versions for a completed idea.
/// *
/// * A user may generate multiple versions using different templates.
/// * Only one version should be marked as current for each idea.
model IdeaBusinessModel {
  id                      String                @id @default(uuid())
  /// *
  /// * Idea for which this business model was generated.
  ideaId                  String                @map("idea_id")
  /// *
  /// * Template selected by the user after idea generation.
  businessModelTemplateId String                @map("business_model_template_id")
  /// *
  /// * Structured AI-generated content keyed by the selected
  /// * template section identifiers.
  content                 Json
  /// *
  /// * Sequential version number within the same idea.
  version                 Int                   @default(1)
  /// *
  /// * Indicates the version currently selected for display,
  /// * preview, and download.
  isCurrent               Boolean               @default(true) @map("is_current")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  businessModelTemplate   BusinessModelTemplate @relation(fields: [businessModelTemplateId], references: [id])
  idea                    Idea                  @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, version])
  @@index([ideaId, isCurrent])
  @@index([businessModelTemplateId])
  @@map("idea_business_models")
}

