<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  iOS application configuration for the Voxidence mobile application.

  Configures application identity, version information, supported device
  orientations, Flutter scene settings, local networking access, and the
  custom Voxidence URL scheme used for password-reset deep links.

  @author Eman
-->
<plist version="1.0">

<dict>

	<!-- Allows smoother rendering behavior on supported iPhone displays. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Defines the application's default development language. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<!-- Application name displayed to the user on iOS. -->
	<key>CFBundleDisplayName</key>
	<string>Voxidence</string>

	<!-- Executable name generated by the Xcode build system. -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- Unique bundle identifier configured in the Xcode project. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<!-- Version of the Info.plist structure. -->
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<!-- Internal application bundle name. -->
	<key>CFBundleName</key>
	<string>Voxidence</string>

	<!-- Declares this bundle as an iOS application. -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- User-visible application version from the Flutter build settings. -->
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<!-- Standard legacy bundle signature value. -->
	<key>CFBundleSignature</key>
	<string>????</string>

	<!-- Internal application build number from Flutter build settings. -->
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!--
	  Registers the custom Voxidence URL scheme.

	  This allows links such as:
	  voxidence://reset-password?token=...
	  to open the application and continue the password-recovery flow.
	-->
	<key>CFBundleURLTypes</key>

	<array>

		<dict>

			<!-- Identifier for the Voxidence custom URL configuration. -->
			<key>CFBundleURLName</key>
			<string>com.voxidence.mobile</string>

			<!-- URL schemes handled by the application. -->
			<key>CFBundleURLSchemes</key>

			<array>
				<string>voxidence</string>
			</array>

		</dict>

	</array>

	<!--
	  App Transport Security configuration.

	  Local networking is allowed so the mobile application can communicate
	  with a backend running on the development machine.
	-->
	<key>NSAppTransportSecurity</key>

	<dict>

		<key>NSAllowsLocalNetworking</key>
		<true/>

	</dict>

	<!-- Indicates that the application requires iPhone OS. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  Configures the application's iOS scene lifecycle used by Flutter.
	-->
	<key>UIApplicationSceneManifest</key>

	<dict>

		<!-- Voxidence uses a single application scene. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>

		<!-- Scene configuration used for the main Flutter interface. -->
		<key>UISceneConfigurations</key>

		<dict>

			<key>UIWindowSceneSessionRoleApplication</key>

			<array>

				<dict>

					<!-- Standard UIKit scene implementation. -->
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>

					<!-- Flutter scene configuration name. -->
					<key>UISceneConfigurationName</key>
					<string>flutter</string>

					<!-- Scene delegate generated for the application module. -->
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>

					<!-- Storyboard used to construct the main Flutter scene. -->
					<key>UISceneStoryboardFile</key>
					<string>Main</string>

				</dict>

			</array>

		</dict>

	</dict>

	<!-- Enables indirect input events such as supported pointer interactions. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Storyboard displayed while the Flutter application is launching. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Main storyboard used by the iOS Flutter application. -->
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Supported application orientations on iPhone. -->
	<key>UISupportedInterfaceOrientations</key>

	<array>

		<string>UIInterfaceOrientationPortrait</string>

		<string>UIInterfaceOrientationLandscapeLeft</string>

		<string>UIInterfaceOrientationLandscapeRight</string>

	</array>

	<!-- Supported application orientations on iPad. -->
	<key>UISupportedInterfaceOrientations~ipad</key>

	<array>

		<string>UIInterfaceOrientationPortrait</string>

		<string>UIInterfaceOrientationPortraitUpsideDown</string>

		<string>UIInterfaceOrientationLandscapeLeft</string>

		<string>UIInterfaceOrientationLandscapeRight</string>

	</array>

</dict>

</plist>