<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VoxidenceLaunchThemeV18" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#EDF7F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#EDF7F3</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#5CBDB9</item>
    </style>

    <style name="VoxidenceNormalThemeV18" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Keep exactly the same starting-window background until Flutter's
             first frame arrives. This removes the cream/white flash between
             Android's launch window and AppLaunchExperience. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#EDF7F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#EDF7F3</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#5CBDB9</item>
    </style>
</resources>
